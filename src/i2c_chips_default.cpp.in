// The built-in I2C chip list: sdcard/i2c/chips.txt as a string, used when
// the SD card has no i2c/ folder (i2c_ident.cpp). Generated by CMake from
// src/i2c_chips_default.cpp.in -- edit sdcard/i2c/chips.txt instead.
extern const char* const kI2cChipsDefault;
const char* const kI2cChipsDefault = R"HIPICHIPS(@HIPI_I2C_CHIPS_TEXT@)HIPICHIPS";
