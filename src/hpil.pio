; src/hpil.pio
;
; HP-IL Frame Receiver
; Reads 11-bit frames from the HP-IL bus (1 start + 8 data + 1 stop + 1 sync)
; in_shiftdir = SHIFT_LEFT, no autopush
; jmp_pin = plus input

.define IN_PLUS_GPIO   12
.define IN_MINUS_GPIO  13
.define OUT_PLUS_GPIO  14
.define OUT_MINUS_GPIO 15

; pin_base = plus
;   pin 0 = plus   (jmp_pin, wait)


.program frame_rx
.wrap_target
restart:
    set x, 10
    wait 1 gpio IN_PLUS_GPIO [2]    ; ★ plus HIGH
    wait 0 gpio IN_PLUS_GPIO        ; ★ plus LOW

bitloop:
    set y, 31
wait_loop:
    jmp pin, go_on                  ; ★ jmp_pin = pin 0 = plus
    jmp y--, wait_loop
    jmp restart
go_on:
    wait 0 gpio IN_PLUS_GPIO [1]    ; ★ plus LOW
    in pins, 1                      ; ★ pin 1 = minus
    jmp x--, bitloop
    push block
.wrap

; HP-IL Frame Transmitter
; Sends 11-bit frames (1 start + 8 data + 1 stop + 1 sync)
; out_shiftdir = SHIFT_LEFT, no autopush
; sideset 2 (minus_out + plus_out), sideset_init = 0b00

.program frame_tx
.side_set 2 opt                    ; 2 sideset pins (minus_out, plus_out)

.wrap_target
    set y, 10                       ; bit counter (11 bits)
    pull                            ; fetch 32-bit data from FIFO
    out null, 21                    ; discard 21 bits (we only send 11)
    out x, 1                        ; read first data bit
    jmp !x, send_zero_first        ; is the first bit 0 or 1?

    ; First bit = 1: positive swing first
    nop side 1 [3]                  ; minus=high, plus=low
    nop side 2 [1]                  ; minus=low, plus=high
    jmp bitloop2                    ; jump to main loop

send_zero_first:
    ; First bit = 0: negative swing first
    nop side 2 [3]                  ; minus=low, plus=high
    nop side 1 [2]                  ; minus=high, plus=low

bitloop2:
    jmp !x, send_zero_bit           ; is the next bit 0 or 1?

    ; Bit = 1: positive swing
    nop side 1 [3]
    nop side 2 [2]
    jmp bit_end

send_zero_bit:
    ; Bit = 0: negative swing
    nop side 2 [3]
    nop side 1 [3]

bit_end:
    nop side 0                      ; bit spacing (both LOW)
    nop [3]
    out x, 1                        ; read next bit
    jmp y--, bitloop2               ; loop to next bit
.wrap
