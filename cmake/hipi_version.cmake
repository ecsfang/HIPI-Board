# hipi_version.cmake -- the version, from git: writes a small header.
#
#   cmake -DOUT=<header> [-DPREFIX=HIPI] [-DSRC=<repo dir>] -P cmake/hipi_version.cmake
#
# Run at every build (the firmware's CMakeLists.txt, tools/hipiview's
# Makefile and CMakeLists.txt). The header is only rewritten when its
# contents change, so an unchanged version rebuilds nothing.
#
# Where the version comes from (git describe, tags v<version>):
#   on the tag v1.2.0               -> 1.2.0
#   5 commits after it              -> 1.2.0-beta.5
#   on the tag, uncommitted changes -> 1.2.0-beta
#   tag v1.3.0-rc1 (a pre-release)  -> 1.3.0-rc1, after it 1.3.0-rc1-beta.N
# Without git (e.g. GitHub's "Source code" zip) the file VERSION is used:
# git archive fills it in itself (.gitattributes: export-subst). Neither
# there: "unknown".
#
# The header:
#   #define <PREFIX>_VERSION_TEXT "1.2.0-beta.5"                      short
#   #define <PREFIX>_VERSION_FULL "1.2.0-beta.5 (abc1234, 2026-10-12)" + commit, build date

if(NOT OUT)
    message(FATAL_ERROR "hipi_version.cmake: -DOUT=<header> is needed")
endif()
if(NOT PREFIX)
    set(PREFIX HIPI)
endif()
if(NOT SRC)
    get_filename_component(SRC "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()

set(describe "")
set(dirty FALSE)

# 1. git
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" describe --tags --match "v[0-9]*" --long --abbrev=7
        WORKING_DIRECTORY "${SRC}"
        OUTPUT_VARIABLE describe
        ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        set(describe "")
    else()
        # Uncommitted changes? HIPI-SD-card.zip doesn't count: the build
        # itself remakes it (CMakeLists.txt), so it can't make a release
        # build look like a beta
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no -- . ":(exclude)HIPI-SD-card.zip"
            WORKING_DIRECTORY "${SRC}"
            OUTPUT_VARIABLE changes
            ERROR_QUIET
            OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT changes STREQUAL "")
            set(dirty TRUE)
        endif()
    endif()
endif()

# 2. The VERSION file (filled in by git archive)
if(describe STREQUAL "" AND EXISTS "${SRC}/VERSION")
    file(STRINGS "${SRC}/VERSION" lines LIMIT_COUNT 1)
    if(lines AND NOT lines MATCHES "\\$Format")
        set(describe "${lines}")
    endif()
endif()

set(commit "")
if(describe MATCHES "^v(.+)-([0-9]+)-g([0-9a-f]+)$")
    # --long form: v<tag>-<commits after it>-g<commit>
    set(base "${CMAKE_MATCH_1}")
    set(ahead "${CMAKE_MATCH_2}")
    set(commit "${CMAKE_MATCH_3}")
    if(ahead GREATER 0)
        set(text "${base}-beta.${ahead}")
    elseif(dirty)
        set(text "${base}-beta")
    else()
        set(text "${base}")
    endif()
elseif(describe MATCHES "^v(.+)$")
    # git archive's short form: exactly on the tag
    set(text "${CMAKE_MATCH_1}")
else()
    set(text "unknown")
endif()

string(TIMESTAMP today "%Y-%m-%d")
if(commit STREQUAL "")
    set(full "${text} (${today})")
else()
    set(full "${text} (${commit}, ${today})")
endif()

set(content "// Generated by cmake/hipi_version.cmake -- do not edit
#pragma once
#define ${PREFIX}_VERSION_TEXT \"${text}\"
#define ${PREFIX}_VERSION_FULL \"${full}\"
")

# Only when it changes (no rebuild otherwise)
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    get_filename_component(dir "${OUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${dir}")
    file(WRITE "${OUT}" "${content}")
    message(STATUS "${PREFIX} version: ${full}")
endif()
